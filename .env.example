# Opcional: sustituye el Client ID web integrado (tipo Aplicación web).
# Ver docs/sync.md
VITE_GOOGLE_CLIENT_ID=

# Deploy web (`npm run web`). Ver docs/deploy-web.md
# USER/HOST por defecto: javi @ jc-applabs.com
WEB_DEPLOY_PATH=/var/www/html/wodtobox
WEB_DEPLOY_URL=http://jc-applabs.com/wodtobox/
# WEB_DEPLOY_USER=javi
# WEB_DEPLOY_HOST=jc-applabs.com
# WEB_DEPLOY_PORT=22
# WEB_DEPLOY_SSH_KEY=
# Solo si la carpeta es de root y hay sudoers NOPASSWD (mejor: chown a javi):
# WEB_DEPLOY_RSYNC_PATH=sudo rsync
