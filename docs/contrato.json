{
  "schemaVersion": 2,
  "applicationId": "com.wodotobox.app",
  "appName": "WODtoBox",
  "viteBase": "./",
  "router": "HashRouter",
  "storage": {
    "localStorage": {
      "wods": "wodplanning.wods",
      "programs": "wodplanning.programs",
      "sessions": "wodplanning.sessions",
      "history": "wodplanning.history",
      "rms": "wodplanning.rms",
      "sync": "wodplanning.sync"
    },
    "sessionStorage": {
      "runSession": "wodplanning.runSession",
      "timerConfigLegacy": "wodplanning.timerConfig"
    }
  },
  "packFormat": "wodplanning.pack",
  "timerKinds": ["amrap", "forTime", "emom", "tabata", "intervals", "stopwatch"],
  "templateIds": ["power-clean-100", "kipping-muscle-up"],
  "heroWodIds": [
    "hero-fran",
    "hero-cindy",
    "hero-grace",
    "hero-helen",
    "hero-annie",
    "hero-diane",
    "hero-karen",
    "hero-isabel",
    "hero-jackie",
    "hero-murph",
    "hero-dt",
    "hero-chad",
    "hero-kalsu"
  ],
  "anchors": [
    { "id": "appId", "file": "capacitor.config.ts", "contains": "com.wodotobox.app" },
    { "id": "androidApplicationId", "file": "android/app/build.gradle", "contains": "com.wodotobox.app" },
    { "id": "hashRouter", "file": "src/App.tsx", "contains": "HashRouter" },
    { "id": "viteBase", "file": "vite.config.ts", "contains": "base: './'" },
    { "id": "timerKindsConst", "file": "src/types/timer.ts", "contains": "TIMER_KINDS" },
    { "id": "normalizeWod", "file": "src/types/wod.ts", "contains": "export function normalizeWod" },
    { "id": "normalizeItem", "file": "src/types/wod.ts", "contains": "export function normalizeItem" },
    { "id": "normalizeTimer", "file": "src/types/timer.ts", "contains": "export function normalizeTimerConfig" },
    { "id": "wodsKey", "file": "src/lib/wods.ts", "contains": "wodplanning.wods" },
    { "id": "programsKey", "file": "src/lib/programs.ts", "contains": "wodplanning.programs" },
    { "id": "sessionsKey", "file": "src/lib/sessions.ts", "contains": "wodplanning.sessions" },
    { "id": "historyKey", "file": "src/lib/history.ts", "contains": "wodplanning.history" },
    { "id": "rmsKey", "file": "src/lib/rms.ts", "contains": "wodplanning.rms" },
    { "id": "runSessionKey", "file": "src/lib/runSession.ts", "contains": "wodplanning.runSession" },
    { "id": "legacyConfigKey", "file": "src/lib/runSession.ts", "contains": "wodplanning.timerConfig" },
    { "id": "reseedTemplates", "file": "src/lib/programs.ts", "contains": "PROGRAM_TEMPLATES" },
    { "id": "restoreTemplate", "file": "src/lib/programs.ts", "contains": "export function restoreTemplate" },
    { "id": "powerCleanId", "file": "src/data/powerClean100.ts", "contains": "power-clean-100" },
    { "id": "kippingId", "file": "src/data/kippingMuscleUp.ts", "contains": "kipping-muscle-up" },
    { "id": "heroWods", "file": "src/data/heroWods.ts", "contains": "hero-fran" },
    { "id": "reseedHeroWods", "file": "src/lib/wods.ts", "contains": "HERO_WODS" },
    { "id": "restoreHeroWod", "file": "src/lib/wods.ts", "contains": "export function restoreHeroWod" },
    { "id": "packFormat", "file": "src/types/pack.ts", "contains": "wodplanning.pack" },
    { "id": "syncKey", "file": "src/lib/sync.ts", "contains": "wodplanning.sync" },
    { "id": "engineSnapshot", "file": "src/lib/engine.ts", "contains": "export function computeSnapshot" }
  ]
}
